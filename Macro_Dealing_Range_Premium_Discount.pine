//@version=6
indicator("Macro Dealing Range & Premium/Discount", overlay=true)

// --- COLORS ---
var color BullishTheme = color.new(#7f9a65, 20)
var color BearishTheme = color.new(#a65c4f, 20)

// --- INPUTS ---
int macro_lookback = input.int(50, "Macro Dealing Range Lookback")

// --- 1. MACRO DEALING RANGE CALCULATIONS ---
float macro_high = ta.highest(high, macro_lookback)
float macro_low = ta.lowest(low, macro_lookback)
float eq_line = (macro_high + macro_low) / 2

bool is_premium = close > eq_line
bool is_discount = close < eq_line

// --- 2. VISUAL MACRO BACKGROUND FILLS ---
p_high = plot(macro_high, color=color.new(BearishTheme, 50), style=plot.style_linebr, title="Premium Top")
p_eq = plot(eq_line, color=color.new(color.gray, 50), style=plot.style_linebr, title="Equilibrium")
p_low = plot(macro_low, color=color.new(BullishTheme, 50), style=plot.style_linebr, title="Discount Bottom")

fill(p_high, p_eq, color=color.new(#a65c4f, 85), title="Premium Zone")
fill(p_eq, p_low, color=color.new(#7f9a65, 85), title="Discount Zone")
