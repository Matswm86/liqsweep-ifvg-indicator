//@version=6
// LiqSweep CVD - cumulative volume delta with pivot divergence.
//
// Companion to the LiqSweep+iFVG Pro overlay. A single Pine script cannot
// draw on the price chart AND in its own pane, so the oscillator lives here.
//
// Delta comes from request.footprint(), which reads completed trades split
// into buy and sell aggression. It needs a TradingView Premium or Ultimate
// plan and a symbol with real trade data (CME_MINI:MNQ1!, not a CFD proxy).
// Where footprint data is missing the pane says so instead of drawing a
// flat line that looks like real information.
indicator("LiqSweep CVD", "CVD", overlay=false, max_labels_count=100, max_lines_count=100)

grpD = "01. Delta"
cvdReset = input.string("Day", "Reset the running total", options=["Never", "Day", "Session"], group=grpD, tooltip="Cumulative delta means little without a starting point. Day restarts each new day, Session restarts at the start of the session below, Never runs from the first loaded bar.")
cvdPick  = input.string("New York", "Which session", options=["New York", "London", "Asia", "Custom"], group=grpD, tooltip="Used only when the reset is set to Session. New York is 0930-1600, London 0300-0930, Asia 2000-0100, all New York time. Custom uses the field below.")
cvdSess  = input.session("0930-1600", "Custom session (New York time)", group=grpD, tooltip="Used only when 'Which session' is set to Custom.")
cvdTicks = input.int(4, "Ticks per footprint row", minval=1, group=grpD, tooltip="Price granularity of the footprint request. MNQ's tick is 0.25, so 4 gives one row per index point. It does not change the bar's total delta, only the resolution the data is fetched at.")

grpX = "02. Divergence"
divOn   = input.bool(true, "Mark divergence against price", group=grpX, tooltip="A divergence is price making a higher high while cumulative delta makes a lower high, or price making a lower low while delta makes a higher low. Both pivots must be confirmed, so a mark appears N bars after the turn and never repaints.")
divPiv  = input.int(5, "Pivot strength (bars each side)", minval=1, group=grpX, tooltip="How many bars must sit on each side of a swing for it to count. Larger keeps only significant turns and reports them later.")
divLine = input.bool(true, "Connect the two delta pivots", group=grpX)

grpY = "03. Appearance"
colUp   = input.color(#26A69A, "Positive", inline="cc", group=grpY)
colDn   = input.color(#EF5350, "Negative", inline="cc", group=grpY)
fillTr  = input.int(88, "Fill transparency", minval=0, maxval=100, group=grpY, tooltip="0 is a solid block of colour, 100 is invisible. The line itself stays fully opaque.")
showTag = input.bool(true, "Value label at the right edge", group=grpY)

// ── Delta source ────────────────────────────────────────────────────
fp = request.footprint(cvdTicks, 70, 300)
bool fpOk = not na(fp)
float barDelta = fpOk ? footprint.delta(fp) : na

bool newDay  = ta.change(time("D")) != 0
string cvdWin = cvdPick == "New York" ? "0930-1600" : cvdPick == "London" ? "0300-0930" : cvdPick == "Asia" ? "2000-0100" : cvdSess
bool inSess  = not na(time(timeframe.period, cvdWin, "America/New_York"))
bool sessOpen = inSess and not inSess[1]
bool doReset = cvdReset == "Day" ? newDay : cvdReset == "Session" ? sessOpen : false

var float cvd = 0.0
if doReset
    cvd := 0.0
if fpOk
    cvd += barDelta

// ── Plot ────────────────────────────────────────────────────────────
color lineCol = cvd >= 0 ? colUp : colDn
pCvd  = plot(fpOk or cvd != 0 ? cvd : na, "CVD", color=lineCol, linewidth=2)
pZero = plot(0, "Zero", color=color.new(color.gray, 70), display=display.none)
fill(pCvd, pZero, color=color.new(lineCol, fillTr), title="CVD fill")
hline(0, "Zero line", color=color.new(color.gray, 60), linestyle=hline.style_dotted)

// ── Divergence between price pivots and delta pivots ────────────────
// Both series are pivoted on the same bars, so the comparison is like for
// like: the delta value recorded is the one at the confirmed swing bar.
float pvHi = ta.pivothigh(high, divPiv, divPiv)
float pvLo = ta.pivotlow(low, divPiv, divPiv)

var float lastHiPrice = na
var float lastHiCvd   = na
var int   lastHiBar   = na
var float lastLoPrice = na
var float lastLoCvd   = na
var int   lastLoBar    = na

if divOn and not na(pvHi)
    float cvdAt = cvd[divPiv]
    int   barAt = bar_index - divPiv
    if not na(lastHiPrice) and pvHi > lastHiPrice and cvdAt < lastHiCvd
        label.new(barAt, cvdAt, "bear div", style=label.style_label_down, color=color.new(colDn, 25), textcolor=color.white, size=size.small)
        if divLine
            line.new(lastHiBar, lastHiCvd, barAt, cvdAt, color=color.new(colDn, 20), width=1)
    lastHiPrice := pvHi
    lastHiCvd   := cvdAt
    lastHiBar   := barAt

if divOn and not na(pvLo)
    float cvdAt = cvd[divPiv]
    int   barAt = bar_index - divPiv
    if not na(lastLoPrice) and pvLo < lastLoPrice and cvdAt > lastLoCvd
        label.new(barAt, cvdAt, "bull div", style=label.style_label_up, color=color.new(colUp, 25), textcolor=color.white, size=size.small)
        if divLine
            line.new(lastLoBar, lastLoCvd, barAt, cvdAt, color=color.new(colUp, 20), width=1)
    lastLoPrice := pvLo
    lastLoCvd   := cvdAt
    lastLoBar   := barAt

// ── Right-edge readout ──────────────────────────────────────────────
var label tag = na
if barstate.islast
    label.delete(tag)
    string txt = fpOk ? str.tostring(cvd, format.volume) : "no footprint data"
    tag := label.new(bar_index + 2, cvd, txt, style=label.style_label_left,
         color=color.new(color.black, 20), textcolor=fpOk ? lineCol : color.new(color.gray, 20), size=size.small)
    if not showTag
        label.delete(tag)

plot(barDelta, "Bar delta", display=display.data_window)
